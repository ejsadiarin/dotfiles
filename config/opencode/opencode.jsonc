{
    "$schema": "https://opencode.ai/config.json",
    // Approval workflow for tool usage
    // In OpenCode v2, permissions are defined as an ordered array of rules: { action, resource, effect }
    // Effects: "allow", "ask", "deny"
    // Evaluation order: last matching rule wins (general rules first, specific overrides after)
    "permissions": [
        { "action": "*", "resource": "*", "effect": "ask" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "list", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "webfetch", "resource": "*", "effect": "allow" },
        { "action": "websearch", "resource": "*", "effect": "allow" },
        { "action": "codesearch", "resource": "*", "effect": "allow" },
        { "action": "skill", "resource": "*", "effect": "allow" },
        { "action": "todoread", "resource": "*", "effect": "allow" },
        { "action": "todowrite", "resource": "*", "effect": "allow" },
        // All MCP-related tool calls (configured servers, generic mcp patterns, and mcp resources)
        { "action": "context7_*", "resource": "*", "effect": "allow" },
        { "action": "playwright_*", "resource": "*", "effect": "allow" },
        { "action": "mcp_*", "resource": "*", "effect": "allow" },
        { "action": "mcp", "resource": "*", "effect": "allow" },
        { "action": "*mcp*", "resource": "*", "effect": "allow" },
        { "action": "opencode_*_mcp_*", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "doom_loop", "resource": "*", "effect": "ask" }
    ],
    // Custom instructions - loaded alongside AGENTS.md
    // Supports: file paths, glob patterns, URLs
    // Note: paths are relative to project root, use ~ for global config paths
    // "instructions": [
    //     "~/.config/opencode/rules/*.md"
    // ],
    "agents": {
        "code-reviewer": {
            "description": "Reviews code for best practices and potential issues",
            "mode": "subagent",
            "system": "You are a code reviewer. Focus on security, performance, and maintainability.",
            "permissions": [
                { "action": "edit", "resource": "*", "effect": "deny" }
            ]
        }
    },
    "commands": {},
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp"
            },
            "playwright": {
                "type": "local",
                "command": [
                    "npx",
                    "@playwright/mcp@latest"
                ]
            }
        }
    },
    "plugins": [
        "@tarquinen/opencode-dcp@latest"
    ]
    // "providers": {
    //     "router": {
    //         "package": "@ai-sdk/openai-compatible",
    //         "name": "modelrelay",
    //         "settings": {
    //             "baseURL": "http://127.0.0.1:7352/v1",
