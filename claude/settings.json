{
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Read(.env)"
    ],
    "ask": [
      "Bash(gh pr create:*)"
    ],
    "defaultMode": "auto"
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    },
    "cc-plugin-easel@builtin": {
      "options": {
        "autoCharts": true
      }
    }
  },
  "theme": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "model": "opus",
  "effortLevel": "medium"
}
