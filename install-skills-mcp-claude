#!/usr/bin/env bash
# Install Claude Code skills, plugins and MCP servers.
#
# - plugins: preferred; Claude Code auto-updates them (marketplaces tracked in settings.json)
# - third-party skills with no plugin: cloned into ${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles-skills
#   (shared with install-skills-opencode), linked into ~/.claude/skills
# - custom skills: skills/skills/* in this repo, linked into ~/.claude/skills
# - MCP servers: user scope (claude mcp add)
# Idempotent. Run after ~/.claude/settings.json is linked (see claude/README.md).
#
# Usage:
#   ./install-skills-mcp-claude            install missing pieces, leave existing entries alone
#   ./install-skills-mcp-claude --force    replace existing skill entries with links
#   ./install-skills-mcp-claude --update   fetch the configured refs again, then relink
#   ./install-skills-mcp-claude --help

set -euo pipefail

SKILLS_NAME="skills-claude"
DOTFILES="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=scripts/lib/skills.sh
source "$DOTFILES/scripts/lib/skills.sh"
parse_skill_args 16 "$@"

CLAUDE_SKILLS="$HOME/.claude/skills"
CLAUDE="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
[[ -x "$CLAUDE" ]] || CLAUDE="$(command -v claude)" || {
  warn "claude not found; install Claude Code first"
  exit 1
}

# --- plugins (preferred: Claude Code keeps them updated) ---
# Marketplaces: name|github repo. `marketplace add` records each one under
# extraKnownMarketplaces in settings.json (tracked, with autoUpdate: true).
MARKETPLACES=(
  "mattpocock|mattpocock/skills"
  "taste-skill|Leonxlnx/taste-skill"
  "cinetic|Leonxlnx/cinetic"
  "juliobsz|juliobsz/skills"
)
PLUGINS=(
  "mattpocock-skills@mattpocock"
  "taste-skill@taste-skill"
  "cinetic@cinetic"
  "awwwards@juliobsz"
  "jury@juliobsz"
)
# Plugins installed by earlier versions of this script.
OLD_PLUGINS=(
  "mattpocock-skills@claude-plugins-official"
)

# --- git-cloned skills: only for repos/skills with no plugin ---
# repo|ref|skills. The Matt skills here live in misc/ and in-progress/, which
# the mattpocock-skills plugin doesn't ship.
SOURCES=(
  "vercel-labs/skills|main|find-skills"
  "wheresryan22/anatomy|main|anatomy"
  "mattpocock/skills|main|claude-handoff git-guardrails-claude-code loop-me migrate-to-shoehorn scaffold-exercises setup-pre-commit setup-ts-deep-modules writing-beats writing-fragments writing-shape"
  "mattpocock/skills|c55ee46073ed923f86ce59a5eb3b6d895095d1b7|resolving-merge-conflicts"
)

install_sources "$CLAUDE_SKILLS" "${SOURCES[@]}"

# Custom skills from this repo.
for dir in "$DOTFILES"/skills/skills/*/; do
  [[ -f "$dir/SKILL.md" ]] || continue
  name="$(basename "$dir")"
  link_skill "${dir%/}" "$CLAUDE_SKILLS" "$name"
  linked=$((linked + 1))
done

# Drop stale links: anything into ~/.agents/skills (Claude Code shouldn't read
# it), and clone links for skills no longer in SOURCES (now from a plugin).
wanted=" $(for e in "${SOURCES[@]}"; do IFS='|' read -r _ _ names <<<"$e"; printf '%s ' $names; done)"
for dest in "$CLAUDE_SKILLS"/*; do
  [[ -L "$dest" ]] || continue
  name="$(basename "$dest")"
  case "$(readlink "$dest")" in
    ../../.agents/skills/* | "$HOME/.agents/skills"/*)
      rm -f "$dest"
      log "removed stale link $name -> ~/.agents/skills"
      ;;
    "$DATA_ROOT"/*)
      if [[ "$wanted" != *" $name "* ]]; then
        rm -f "$dest"
        log "removed $name (now provided by a plugin)"
      fi
      ;;
  esac
done

log "skills: $linked linked, $failed issue(s)"

# --- plugins ---
known="$("$CLAUDE" plugin marketplace list 2>/dev/null || true)"
for entry in "${MARKETPLACES[@]}"; do
  IFS='|' read -r name repo <<<"$entry"
  if grep -qw "$name" <<<"$known"; then
    log "marketplace $name already added"
  else
    log "adding marketplace $name ($repo)"
    "$CLAUDE" plugin marketplace add "$repo"
  fi
done

installed="$("$CLAUDE" plugin list 2>/dev/null || true)"
for plugin in "${OLD_PLUGINS[@]}"; do
  if grep -qF "$plugin" <<<"$installed"; then
    log "uninstalling old plugin $plugin"
    "$CLAUDE" plugin uninstall "$plugin"
  fi
done
for plugin in "${PLUGINS[@]}"; do
  if grep -qF "$plugin" <<<"$installed"; then
    log "plugin $plugin already installed"
  else
    log "installing plugin $plugin"
    "$CLAUDE" plugin install --scope user "$plugin"
  fi
done

# --- MCP servers (user scope, stored in ~/.claude.json) ---
# Context7 comes from the claude.ai account connector; don't add it here.
add_mcp() {
  local name="$1"
  shift
  if "$CLAUDE" mcp get "$name" >/dev/null 2>&1; then
    log "mcp $name already registered"
  else
    log "registering mcp $name"
    "$CLAUDE" mcp add --scope user "$name" -- "$@"
  fi
}
add_mcp playwright npx -y @playwright/mcp@latest # needs node on PATH

log "done"
((failed == 0))
